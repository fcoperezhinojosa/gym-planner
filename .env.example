# Sin DATABASE_URL se usa una base de datos local embebida (PGlite) en ./.pglite
# Producción: cadena de conexión de Postgres (p. ej. Prisma Postgres desde Vercel Storage)
DATABASE_URL=

# Obligatorio en producción. Genera uno con: openssl rand -base64 32
SESSION_SECRET=

# Opcional: si lo pones, hace falta este código para registrarse (para invitar a amigos)
INVITE_CODE=

# Zona horaria para saber qué día es "hoy"
NEXT_PUBLIC_TIME_ZONE=Europe/Madrid
